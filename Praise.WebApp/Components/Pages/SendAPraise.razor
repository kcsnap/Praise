@page "/sendapraise"
@rendermode InteractiveServer
@inject AuthenticationStateProvider Auth
@inject IPraiseLogic praiseLogic
@inject IPraiseTypeLogic praiseTypeLogic
@inject IPraiseUserLogic praiseUser
@inject IHttpContextAccessor _httpContextAccessor
@inject NavigationManager _navigationManager
@inject ILogger<SendAPraise> _logger
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorBootstrap
@using Praise.WebApp.Logic
@using Praise.WebApp.Logic.Interfaces
@using Praise.Models;
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<div class="line-text">
    <span>Send Praise</span>
</div>

@if (!PraiseSent)
{
    @if(ShowSummary())
    {
        <div class="step"><span>Step 1</span> @selectedPraiseType.Description <img src="/images/@selectedPraiseType.ImageUrl" class="praise-image praise-image-small img-fluid" /></div>
        @if(InReview)
        {
            <div class="step"><span>Step 2</span> @RecipientEmail</div>
        }
    }

    @if(selectedPraiseType == null)
    {
        <div class="step"><span>Step 1</span> Select Praise Type</div>
        
        <div class="row">
            @foreach (var praiseType in praiseTypes)
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 col-12 justify-content-center pb-4">
                    <div class="praise-container">
                        <img src="/images/@praiseType.ImageUrl" class="praise-image img-fluid" />
                        <span class="praise-text">@praiseType.Description</span>
                        <Button @onclick="() => SelectedPraiseType(praiseType)" Class="button">Select this Praise</Button>
                    </div>
                </div>
            }
        </div>
    }

    @if (selectedPraiseType != null && !InReview)
    {
        <div class="step"><span>Step 2</span> Enter Recipient's Email Address</div>
        <div class="input-group input-group-lg">
            <TextInput @bind-Value="@RecipientEmail" Placeholder="Enter email address" Class="form-control" />
        </div>
        <Button Class="float-end mt-1 me-2 button" @onclick="ReviewAndSend">Review & Send</Button>
    }

    @if (InReview)
    {
        <Button Class="float-end me-2 button" @onclick="SendPraise">Send It!</Button>    
    }
}
else
{
    <div class="alert alert-info">Well done! We've sent your praise to @RecipientEmail</div>
    <div class="step"><span>Did you know...</span> When you give someone genuine praise, both you and the person receiving it get a little boost of dopamine.</div>
    <div class="col-sm-12 pt-5" style="text-align:center">
        <Button Class="me-2 button" @onclick="NewPraise">Give More Praise</Button>
    </div>
}

@code {
    private IList<PraiseTypeMetadata> praiseTypes = new List<PraiseTypeMetadata>();
    private PraiseTypeMetadata selectedPraiseType = null;
    private string currentUser = string.Empty;
    private string RecipientEmail = null;
    private bool InReview = false;
    private bool PraiseSent = false;

    protected override async Task OnInitializedAsync()
    {
        // var user = (await Auth.GetAuthenticationStateAsync()).User;

        // if (user.Identity?.IsAuthenticated == true)
        //     currentUser = user.Identity?.Name;
        // _logger.LogInformation("SendAPraise.OnInitializedAsync() currentUser = " + currentUser);


        // var ctx = _httpContextAccessor.HttpContext;       
        // if (ctx.User.Identity.IsAuthenticated)
        // {
        //     currentUser = ctx.User.Identity.Name;
        // }
        // else
        // {
        //     throw new Exception("Unable to identify user from HttpContext");   
        // }

        praiseTypes = await praiseTypeLogic.GetPraiseTypes(praiseUser);
    }

    protected async Task SendPraise()
    {
        try
        {
            try
            {
                var email = RecipientEmail;
            }
            catch
            {
                _logger.LogError("TO REMOVE - RecipientEmail is NULL");

            }
            try
            {
                var name = selectedPraiseType;
            }
            catch
            {
                _logger.LogError("TO REMOVE - selectedPraiseType is NULL");

            }


            // send the praise to the recipient and confirmation to user
            await praiseLogic.SendPraise(
                praiseUser,
                RecipientEmail,
                selectedPraiseType
            );
            PraiseSent = true;
        }
        catch(Exception ex)
        {
            var msg = "SendAPraise.SendPraise: [see inner exception]"; 
            _logger.LogError(ex, msg);

            // todo - how to visualise this to the user
            throw new Exception(msg, ex);
        }
    }

    protected async Task ReviewAndSend()
    {
        // trigger summary view before sending
        InReview = true;
    }

    protected bool ShowSummary()
    {
        return selectedPraiseType != null;
    }

    protected async Task SelectedPraiseType(PraiseTypeMetadata praiseType)
    {
        // add to summary, hide rest and move to next section
        selectedPraiseType = praiseType;
    }

    private void NewPraise(MouseEventArgs args)
    {
        _navigationManager.Refresh(true);
    }
}
