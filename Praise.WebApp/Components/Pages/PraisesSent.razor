@page "/praisessent"
@inject IPraiseLogic praiseLogic
@inject IPraiseUserLogic praiseUser
@using Praise.Models
@using Praise.Models.Generic
@using Praise.WebApp.Logic
@using Praise.WebApp.Logic.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="line-text">
    <span>Praises Sent</span>
</div>

<div class="row">
    <div class="col-6 offset-3">
        
        @if(_PraisesSent != null)
        {
            foreach(var praise in _PraisesSent)
            {
                <div class="row">
                    <div class="col-3">
                        <img src="/images/@praise.ImageUrl" style="float:right;width:80px" />
                    </div>
                    <div class="col-9">
                        <span style="display:block;font-size:40px;font-weight:bold;">@praise.Text</span>
                        <span style="display:block;font-size:80%">@praise.ToEmail, @praise.PraiseDate.ToString("dd MMMM yyyy")</span>
                        <hr />
                    </div>
                </div>
            }
        }
        
    </div>
</div>
@code {
    IEnumerable<PraiseDetails> _PraisesSent;

    protected override async Task OnInitializedAsync()
    {
        StateHasChanged();
        _PraisesSent = await praiseLogic.GetPraisesSent(praiseUser);
    }
}
