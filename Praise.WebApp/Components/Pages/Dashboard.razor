@page "/dashboard"
@attribute [StreamRendering]
@inject IRecentActivityLogic recentActivityLogic
@inject IPraiseUserLogic praiseUser
@inject IBadgeLogic _badgeLogic
@using BlazorBootstrap
@using Praise.Models
@using Praise.WebApp.Components.Addins
@using Praise.WebApp.Components.Modals
@using Praise.WebApp.Logic
@using Praise.WebApp.Logic.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@* <a href="https://auth0.com/blog/what-is-blazor-tutorial-on-building-webapp-with-authentication/#Securing-the-Application-with-Auth0">Auth0 Tutorial</a> *@

<div class="line-text">
    <span>Recent Praises Sent</span>    
</div>

<div class="row">
    <div class="col-sm-12 d-flex justify-content-end">
        <a href="/praisessent" class="small-button">View all</a>
    </div>
    @if (RecentActivity != null)
    {
        if (RecentActivity.PraisesSent != null && RecentActivity.PraisesSent.Count() > 0)
        {
            @foreach (var sent in RecentActivity.PraisesSent)
            {
                <div class="col-xl-3 col-lg-4 col-sm-6 col-12 justify-content-center">
                    <div class="praise-container">
                        <img src="/images/@sent.ImageUrl" class="praise-image img-fluid" />
                        <span class="praise-text">@sent.Text</span>
                        <span class="praise-email">to @sent.ToEmail</span>
                        <span class="praise-date">@sent.PraiseDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
            }
            <div class="col-sm-12 pt-5" style="text-align:center">
                <a class="button" href="/sendapraise">Send Praise</a> 
            </div>
        }
        else
        {
            <div class="col-sm-12">Send your <a href="/sendapraise">First Praise</a> now!</div>
        }
    }
    else
    {
        <div class="col-sm-12">
            Loading Recent Activity...
        </div>
    }
</div>

<div class="line-text pt-5">
    <span>Recent Praises Received</span>
</div>

<div class="row">
    <div class="col-sm-12">
        <a href="/praisesreceived" class="small-button">View all</a>
    </div>
        @if (RecentActivity != null)
        {
            if (RecentActivity.PraisesReceived != null && RecentActivity.PraisesReceived.Count() > 0)
            {
                @foreach (var sent in RecentActivity.PraisesReceived)
                {
                    <div class="col-xl-3 col-lg-4 col-sm-6 col-12 justify-content-center">
                        <div class="praise-container">
                            <img src="/images/@sent.ImageUrl" class="praise-image" />
                            <span class="praise-text">@sent.Text</span>
                            <span class="praise-email">from @sent.FromEmail</span>
                            <span class="praise-date">@sent.PraiseDate.ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-sm-12">Send your <a href="/sendapraise">First Praise</a> now and get the ball rolling!!</div>
            }
        }
        else
        {
            <div class="col-sm-12">
                Loading Recent Activity...
            </div>
        }    
</div>

<div class="line-text">
    <span>Badges</span>    
</div>
<div class="row">
    <div class="col-sm-12">
        @if (BadgeGroups != null)
        {
            if (BadgeGroups.Count() > 0)
            {
                @foreach (var badgeGroup in BadgeGroups)
                {
                    <div class="col-12 pb-5">
                        <div class="badge-group-container">
                            <h2 class="badge-group-title">@badgeGroup.BadgeTitle</h2>

                            <!-- badge images from https://www.reshot.com/free-svg-icons/item/page-rank-badge-EVNCRKXUSF/ -->
                            <!-- https://www.reshot.com/free-svg-icons/ -->
                            <div class="row">
                                @foreach(var badge in badgeGroup.BadgeDetails)
                                {
                                    <PraiseBadgeAddIn badgeVm="badge" />

                                    @* <div class="col-xl-3 col-lg-4 col-sm-6 col-12 justify-content-center text-center">
                                        <img src="/images/badges/@badge.BadgeImageUrl" class="badge-image" />
                                        <span class="badge-subtitle">@badge.BadgeSubtitle</span>

                                        @if(badge.BadgeDateEarned != null)
                                        {
                                            <span class="badge-date badge-date-earned">Earned @badge.BadgeDateEarned?.ToString("dd MMMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-date">Not yet earned</span>
                                        }
                                        @if(badge.BadgeDateClaimed != null)
                                        {
                                            <span class="badge-date badge-date-earned">Claimed @badge.BadgeDateClaimed?.ToString("dd MMMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-date">Not yet claimed</span>
                                        }
                                    </div> *@
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-sm-12">
                    <div class="alert alert-danger">WARNING - GAME AND/OR BADGES NOT REGISTRED CORRECTLY</div>
                </div>
            }
        }
        else
        {
            <div class="col-sm-12">
                Loading Recent Activity...
            </div>
        }
    </div>
</div>

<Modal @ref="modal" />

@code {
    string Name = "";
    RecentActivity RecentActivity;
    private Modal modal = default!;
    private IEnumerable<BadgeGroupViewModel> BadgeGroups;

    protected override async Task OnInitializedAsync()
    {
        //StateHasChanged();
        RecentActivity = await recentActivityLogic.GetRecentActivityForUser(praiseUser);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // at this point retrieve all achievements and display those unclaimed...
            BadgeGroups = await _badgeLogic.GetBadges(praiseUser);
            StateHasChanged();
            // var parameters = new Dictionary<string, object>();
            // parameters.Add("BadgeTitle", "Welcome Newbie");
            // await modal.ShowAsync<BadgeAwardComponent>(title: "You've earned a new Badge", parameters: parameters);
        }
    }
}