@page "/account/callback"
@* @using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage *@
@using System.Net.Http.Headers;
@using Praise.WebApp.Logic.Interfaces
@inject IHttpContextAccessor _contextAccessor
@inject NavigationManager NavigationManager
@inject IPraiseApiWrapper PraiseApi
@inject IPraiseUserLogic praiseUserLogic
@inject ILogger<Callback> _logger

<h3>Failed Login</h3>
<p>Please try again</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _logger.LogInformation("Callback.OnInitializedAsync() checking context and isauthenticated");

            // save the user's information in the local storage
            var ctx = _contextAccessor.HttpContext;
            _logger.LogInformation("Callback.OnInitializedAsync() context not null, check authentication");
            if (ctx.User.Identity.IsAuthenticated)
            {
                _logger.LogInformation("Callback.OnInitializedAsync() user is authentication");
                await PraiseApi.Initialise(praiseUserLogic);
            }
        }
        catch(Exception ex)
        {
            _logger.LogError(ex.Message);
            //throw new Exception("Error on callback after authenticating user", ex);
        }

        NavigationManager.NavigateTo("Dashboard");
    }
}
