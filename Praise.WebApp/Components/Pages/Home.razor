@page "/"
@attribute [StreamRendering]
@inject IRecentActivityLogic recentActivityLogic
@using Praise.Models
@using Praise.WebApp.Logic
@using Praise.WebApp.Logic.Interfaces

<PageTitle>Home</PageTitle>

<h1>Hello @Name</h1>
<a href="https://auth0.com/blog/what-is-blazor-tutorial-on-building-webapp-with-authentication/#Securing-the-Application-with-Auth0">Auth0 Tutorial</a>

<h3>Recent Praises Sent</h3>
<table>
    <tr>
        @if (RecentActivity != null)
        {
            if(RecentActivity.PraisesSent != null)
            {
                @foreach(var sent in RecentActivity.PraisesSent)
                {
                    <td>
                        <span>
                            @sent.ToEmail:<br/>
                            @sent.Text<br />
                            @sent.PraiseDate.ToString("dd MMMM yyyy")<br />
                        </span>
                    </td>
                }
                <td>
                    <a href="/sendapraise">Send a Praise</a> | <a href="/praisessent">View all</a>
                </td>
            }
            else
            {
                <td>Send your <a href="/sendapraise">First Praise</a> now!</td>
            }
        }
        else
        {
            <td>
                Loading Recent Activity...
            </td>
        
        }
    </tr>
</table>

<hr />

<h3>Recent Praises Received</h3>
<table>
    <tr>
        @if (RecentActivity != null)
        {
            if (RecentActivity.PraisesReceived != null)
            {
                @foreach (var sent in RecentActivity.PraisesReceived)
                {
                    <td>
                        <span>
                            @sent.ToEmail:<br />
                            @sent.Text<br />
                            @sent.PraiseDate.ToString("dd MMMM yyyy")<br />
                        </span>
                    </td>
                }
                <td>
                    <a href="/praisesreceived">View all</a>
                </td>
            }
            else
            {
                <td>Send your <a href="/sendapraise">First Praise</a> now and get the ball rolling!</td>
            }
        }
        else
        {
            <td>
                Loading Recent Activity...
            </td>
        }
    </tr>
</table>

<hr />

<h3>Recent Badges Earned</h3>
<table>
    <tr>
        <td>COMING SOON</td>
        @* @if (RecentActivity != null && RecentActivity.BadgesReceived != null)
        {
            @foreach (var badge in RecentActivity.BadgesReceived)
            {
                <td>
                     <span>@badge.Text</span>
                </td>
            }
        }
        <td>
            <a href="/badgesearned">View all</a>
        </td> *@
    </tr>
</table>

@code {
    string Name = "";
    RecentActivity RecentActivity;

    protected override async Task OnInitializedAsync()
    {
        StateHasChanged();
        // TODO - improve response, Simulate asynchronous loading to demonstrate streaming rendering
        // await Task.Delay(2000);
        RecentActivity = await recentActivityLogic.GetRecentActivityForUser();
    }
}