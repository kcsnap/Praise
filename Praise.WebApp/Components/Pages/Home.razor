@page "/"
@using BlazorBootstrap
@using Praise.WebApp.Components.Modals
@inject ILogger<Home> logger
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div class="page-container">
    <div class="page-container-inner">
        <div class="page-container-inner-inner">
            <img src="/images/praise-heroimage.png" />
            <div class="hero-container-inner-caption">
                <span class="hero-message">Giving genuine praise not only lifts others, it sparks a dopamine boost in you too - fuelling motivation, connection and a cycle of positivity.</span>
                <a class="button try-now" href="/Dashboard">Try it now</a>
            </div>
        </div>

        <div class="page-container white-section">
            <div class="page-container-inner-inner white-section">
                <div class="section-container row">
                    <div class="col-md-4">
                        <img src="/images/praise-thankyou.png" />
                        <h4>Positive Dopamine</h4>
                        <p>Read about evidence-backed research that confirms the physical and emotional positive effects to both you and the receiver as a result of giving praise. </p>
                        <p><a href="https://www.cell.com/neuron/fulltext/S0896-6273(08)00266-3" target="_blank">read more</a></p>
                    </div>
                    <div class="col-md-4">
                        <img src="/images/praise-magic.png" />
                        <h4>Karma Rules</h4>
                        <p>Many cultures and religions believe in Karma: "good works and deeds lead to good Karma and happiness". There's always room for improving your Karma today!</p>
                        <p><a href="https://www.originalbuddhas.com/blog/karma?srsltid=AfmBOooEbcgSbLYHvJphPfpniANoYGMSqQnxG5-2E45_CeA-YgdFvToz" target="_blank">read more</a></p>
                    </div>
                    <div class="col-md-4">
                        <img src="/images/praise-inspiration.png" />
                        <h4>Earn Crypto</h4>
                        <p>Where before have you been able to receive tangible rewards for simply saying 'thank you' or 'Good job'!? The more you praise, the more you earn!</p>
                        <p><a href="/EarnCryptoForGivingPraise">read more</a></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="page-container">
            <div class="page-container-inner-inner page-container-inner-inner-flex">
                <div class="section-container">
                    <div class="row">
                        <div class="col-md-12">
                            <h2>Why Praise?</h2>
                            <p>In today's fast-paced world, genuine recognition often takes a backseat. Praise is here to change that. Our platform is designed to make it easy and fun to give and receive authentic praise, fostering a culture of appreciation and positivity.</p>
                            <p>Whether it's a colleague's innovative idea, a friend's unwavering support, or a family member's everyday kindness, Praise helps you acknowledge and celebrate these moments. By making praise a regular part of your interactions, you can enhance relationships, boost morale, and create a more supportive environment.</p>
                            <span class="mission">Join us in spreading positivity and encouragement, one praise at a time.</span><br />
                            <a class="button try-now" href="/Dashboard">Try it now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page-container white-section">
            <div class="page-container-inner-inner white-section">
                <div class="section-container no-padding">
                    <div class="row">
                        <div class="col-md-6">
                            <img alt="happy woman" src="/images/happy-woman-2.jpg" class="full-size" />
                        </div>
                        <div class="col-md-6">
                            <table style="height:100%;width:100%">
                                <tr>
                                    <td class="align-middle" style="width:100%">
                                       <span class="mission">Get your first positive dopamine fix, right now...</span><br />
                                        <a class="button try-now" href="/Dashboard">Try it now</a>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                 </div>
