{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "sites_Praise_WebApp_name": {
      "defaultValue": "Praise-WebApp-Prod",
      "type": "String",
      "metadata": { "description": "Name of the Web App" }
    },
    "sites_Praise_Api_name": {
      "defaultValue": "Praise-Api-Prod",
      "type": "string",
      "metadata": { "description": "Name of the Api" }
    },
    "appInsightsName": {
      "defaultValue": "Praise-AppInsights-Prod",
      "type": "string",
      "metadata": { "description": "Application Insights component name (prod)" }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "/subscriptions/66673944-b353-4256-b71c-0cd8751c81c0/resourceGroups/DefaultResourceGroup-SUK/providers/Microsoft.OperationalInsights/workspaces/DefaultWorkspace-66673944-b353-4256-b71c-0cd8751c81c0-SUK",
      "metadata": { "description": "Resource ID of the Log Analytics Workspace for prod (e.g., /subscriptions/<subId>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<workspaceName>)" }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[format('{0}{1}', 'prs-kv-p-', utcNow('yyyyMMddHHmm'))]"
    },
    "cosmosDbName": {
      "type": "string",
      "defaultValue": "[format('{0}-{1}', 'prs-db-p-', utcNow('yyyyMMddHHmm'))]"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Location for all resources" }
    },
    "sku": {
      "type": "string",
      "defaultValue": "F1",
      "metadata": { "description": "SKU for the App Service Plan (F1 = Free)" }
    }
  },
  "variables": {
    "planName": "[concat(parameters('sites_Praise_WebApp_name'), '-plan')]",
    "webSiteName": "[parameters('sites_Praise_WebApp_name')]",
    "apiSiteName": "[parameters('sites_Praise_Api_name')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-02-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "Free"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[variables('webSiteName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[variables('apiSiteName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      }
    },

    /* -------------------- Application Insights (prod) -------------------- */
    {
      "type": "microsoft.insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Flow_Type": "Redfield",
        "Request_Source": "IbizaAIExtensionEnablementBlade",
        "RetentionInDays": 90,
        "WorkspaceResourceId": "[parameters('logAnalyticsWorkspaceResourceId')]",
        "IngestionMode": "LogAnalytics",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },

    /* -------------------- Key Vault -------------------- */
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2019-09-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "accessPolicies": [
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[reference(resourceId('Microsoft.Web/sites', variables('webSiteName')), '2021-02-01', 'Full').identity.principalId]",
            "permissions": { "secrets": [ "get", "list" ] }
          },
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[reference(resourceId('Microsoft.Web/sites', variables('apiSiteName')), '2021-02-01', 'Full').identity.principalId]",
            "permissions": { "secrets": [ "get", "list" ] }
          }
        ],
        "enabledForDeployment": true,
        "enabledForTemplateDeployment": true,
        "enabledForDiskEncryption": false
      }
    },

    /* -------------------- Cosmos DB + SQL DB + Container -------------------- */
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2021-06-15",
      "name": "[parameters('cosmosDbName')]",
      "location": "[parameters('location')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0
          }
        ],
        "enableAutomaticFailover": false,
        "isVirtualNetworkFilterEnabled": false
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2021-06-15",
      "name": "[format('{0}/{1}', parameters('cosmosDbName'), 'PraiseDatabase')]",
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbName'))]"
      ],
      "properties": {
        "resource": { "id": "PraiseDatabase" },
        "options": {}
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2021-06-15",
      "name": "[format('{0}/{1}/{2}', parameters('cosmosDbName'), 'PraiseDatabase', 'PraiseContainer')]",
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', parameters('cosmosDbName'), 'PraiseDatabase')]"
      ],
      "properties": {
        "resource": {
          "id": "PraiseContainer",
          "partitionKey": {
            "paths": [ "/id" ],
            "kind": "Hash"
          }
        },
        "options": {}
      }
    },

    /* -------------------- Wire both Web Apps to App Insights -------------------- */
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-02-01",
      "name": "[concat(variables('webSiteName'), '/appsettings')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('webSiteName'))]",
        "[resourceId('microsoft.insights/components', parameters('appInsightsName'))]"
      ],
      "properties": {
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]",
        "ApplicationInsightsAgent_EXTENSION_VERSION": "~3"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2021-02-01",
      "name": "[concat(variables('apiSiteName'), '/appsettings')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('apiSiteName'))]",
        "[resourceId('microsoft.insights/components', parameters('appInsightsName'))]"
      ],
      "properties": {
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]",
        "ApplicationInsightsAgent_EXTENSION_VERSION": "~3"
      }
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[parameters('sites_Praise_WebApp_name')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('sites_Praise_WebApp_name'), '.azurewebsites.net')]"
    },
    "ApiName": {
      "type": "string",
      "value": "[parameters('sites_Praise_Api_name')]"
    },
    "ApiUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('sites_Praise_Api_name'), '.azurewebsites.net')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2019-09-01').vaultUri]"
    },
    "cosmosDbEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosDbName'))).documentEndpoint]"
    },
    "appInsightsInstrumentationKey": {
      "type": "string",
      "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
    }
  }
}
